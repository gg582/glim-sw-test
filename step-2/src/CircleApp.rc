#include <afxres.h>
#include "resource.h"

IDD_CIRCLEDIALOG DIALOGEX 0, 0, 800, 600
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Circle App"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Click Radius:", IDC_STATIC, 10, 10, 50, 8
    EDITTEXT        IDC_EDIT_RADIUS, 65, 8, 40, 12, ES_NUMBER
    LTEXT           "Edge Thickness:", IDC_STATIC, 120, 10, 60, 8
    EDITTEXT        IDC_EDIT_THICKNESS, 185, 8, 40, 12, ES_NUMBER
    LTEXT           "Coords:", IDC_STATIC, 240, 10, 30, 8
    LTEXT           "", IDC_STATIC_COORDS, 275, 10, 500, 8
    PUSHBUTTON      "Reset", IDC_BUTTON_RESET, 10, 30, 50, 14
    PUSHBUTTON      "Random Move", IDC_BUTTON_RANDOM, 70, 30, 70, 14
END
